f_depth4_key_candidates() =>
    array.from(
      syminfo.tickerid,
      syminfo.prefix + ":" + syminfo.ticker,
      syminfo.ticker
    )

f_depth4_find_index() =>
    keys = f_depth4_key_candidates()
    found = -1
    for ki = 0 to array.size(keys) - 1
        key = str.upper(array.get(keys, ki))
        for i = 0 to array.size(DEPTH4_TV_KEYS) - 1
            if key == array.get(DEPTH4_TV_KEYS, i)
                found := i
                break
            if key == array.get(DEPTH4_SYMBOLS, i)
                found := i
                break
        if found >= 0
            break
    found

f_depth4_dir_label(code) =>
    code > 0 ? "LONG" : code < 0 ? "SHORT" : "MIXED"

f_depth4_dir_color(code) =>
    code > 0 ? color.new(#22c55e, 0) : code < 0 ? color.new(#ef4444, 0) : color.new(#f59e0b, 0)

var table depth4Panel = table.new(position.top_right, 1, 8, bgcolor=color.new(#111110, 10), border_width=1, border_color=color.new(#E8473F, 40))

if barstate.islast
    idx = f_depth4_find_index()
    table.cell(depth4Panel, 0, 0, "DEPTH4 Macro Signal", text_color=color.new(#E8473F, 0), text_size=size.small)
    if idx < 0
        table.cell(depth4Panel, 0, 1, "No mapped macro signal for this chart symbol.", text_color=color.new(#888888, 0), text_size=size.tiny)
        table.cell(depth4Panel, 0, 2, "Browse live SIGNALS:", text_color=color.new(#888888, 0), text_size=size.tiny)
        table.cell(depth4Panel, 0, 3, "https://www.depth4.com", text_color=color.new(#ffffff, 0), text_size=size.tiny)
    else
        dirCode = array.get(DEPTH4_DIR, idx)
        room = array.get(DEPTH4_ROOM, idx)
        table.cell(depth4Panel, 0, 1, array.get(DEPTH4_NAME, idx), text_color=color.white, text_size=size.small)
        table.cell(depth4Panel, 0, 2, f_depth4_dir_label(dirCode) + " · " + str.tostring(room, "#") + "% room · " + array.get(DEPTH4_ROOM_BAND, idx), text_color=f_depth4_dir_color(dirCode), text_size=size.tiny)
        table.cell(depth4Panel, 0, 3, array.get(DEPTH4_STRENGTH, idx), text_color=color.new(#888888, 0), text_size=size.tiny)
        leanText = array.get(DEPTH4_LEAN, idx)
        if str.length(leanText) > 0
            table.cell(depth4Panel, 0, 4, leanText, text_color=color.new(#888888, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 5, array.get(DEPTH4_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 6, "Full cascade →", text_color=color.new(#888888, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 7, array.get(DEPTH4_URL, idx), text_color=color.new(#E8473F, 0), text_size=size.tiny)
        else
            table.cell(depth4Panel, 0, 4, array.get(DEPTH4_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 5, "Full cascade →", text_color=color.new(#888888, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 6, array.get(DEPTH4_URL, idx), text_color=color.new(#E8473F, 0), text_size=size.tiny)
            table.cell(depth4Panel, 0, 7, "", text_color=color.new(#111110, 0), text_size=size.tiny)
