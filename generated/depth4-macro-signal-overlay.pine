var string[] MACRO_TV_KEYS = array.from("BINANCE:BTCUSDT", "OANDA:XAUUSD", "OANDA:XAGUSD", "NASDAQ:NVDA", "NASDAQ:AAPL", "NASDAQ:GOOGL", "AMEX:SPY", "NASDAQ:QQQ", "AMEX:IWM", "AMEX:GLD", "COMEX:GC1!", "AMEX:XLE", "AMEX:GDX", "NASDAQ:TLT", "OANDA:EURUSD", "OANDA:USDJPY", "OANDA:NZDUSD", "AMEX:KIE", "NYMEX:NG1!", "AMEX:EEM", "AMEX:FXY", "NYSE:RTX", "AMEX:ITA", "ICEUS:SB1!", "OANDA:USDCAD")
