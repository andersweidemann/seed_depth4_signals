var string[] MACRO_STRENGTH = array.from("Mixed fleet — Mixed picture", "Mixed fleet — Mixed picture", "Clear signal", "Mixed fleet — Mixed picture", "Mixed fleet — Mixed picture", "Flagged — Building", "Mixed fleet — Mixed picture", "Mixed fleet — Mixed picture", "Building", "Mixed fleet — Mixed picture", "Mixed fleet — Mixed picture", "Mixed fleet — Mixed picture", "Flagged — Building", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal", "Clear signal")
var string[] MACRO_CAUSE = array.from("If state PUCs keep fast-tracking datacenter interconnection over crypto load,…", "KIE, BZ, XAUUSD — Iran's IRGC seized a cargo vessel near Oman and jammed GPS…", "Gold tests resistance as haven flows intensify. Silver lags on industrial drag.…", "IWM rises on the direct D1→D2 channel.", "IWM rises on the direct D1→D2 channel.", "IWM, copper, energy stocks — Small-cap industrials catch up; copper demand from rearmament electrification sp…", "KIE, BZ, XAUUSD — Iran's IRGC seized a cargo vessel near Oman and jammed GPS…", "KIE, BZ, XAUUSD — Iran's IRGC seized a cargo vessel near Oman and jammed GPS…", "IWM, copper, energy stocks — Small-cap industrials catch up; copper demand from rearmament electrification sp…", "NUGT, XME — Miners get crushed as CTA models flip short", "intermediate bonds, dollar, EURUSD — Trend funds cover Treasury shorts,…", "Long bonds breathe as gold pivots to inflation hedge. Euro reprices energy-tax drag. Defense rerates.", "Gold rotates from war hedge to Fed-hedge. Pension cash cuts from 18% to 12% favor…", "If Hormuz harassment stays chronic and insurers keep Gulf premiums sticky,…", "KC — If the Oman backchannel stalls and escort operations stretch into late summer,…", "Growth fund managers may rotate into IWM's tech and component names if hardware pilot announcements…", "HYG protection selling reverses. Spreads widen fast. Gold and yen safe-haven bids return.", "Trend funds and commodity ETF allocators add BDRY exposure when July BDIY spot holds above…", "Trend funds and commodity ETF allocators add BDRY exposure when July BDIY spot holds above…", "XME, iron ore, long-term Treasuries — copper miners, SCCO, TECK —…", "XME, iron ore, long-term Treasuries — copper miners, SCCO, TECK —…", "XME, iron ore, long-term Treasuries — copper miners, SCCO, TECK —…", "USDNOK, CAD — CTAs sell EURUSD via forwards. Airlines bleed on fuel hedges expiring.")
var string[] MACRO_NAME = array.from("Bitcoin", "Gold Spot", "Silver Spot", "S&P 500", "Nasdaq 100", "Russell 2000", "Gold Spot", "Gold Spot", "Energy Select Sector", "Gold Miners ETF", "20+ Year Treasuries", "Euro / US Dollar", "US Dollar / Japanese Yen", "Dry bulk shipping", "Natural Gas", "Emerging Markets", "Euro / Japanese Yen", "FFA", "BDIY", "Vale S.A.", "Southern Copper", "Teck Resources", "US Dollar / Norwegian Krone")
var string[] MACRO_LEAN = array.from("18 thesises lean up · 16 lean down · 1 neutral", "72 thesises lean up · 41 lean down · 7 neutral", "", "20 thesises lean up · 28 lean down · 11 neutral", "18 thesises lean up · 18 lean down · 5 neutral", "", "72 thesises lean up · 41 lean down · 7 neutral", "72 thesises lean up · 41 lean down · 7 neutral", "", "48 thesises lean up · 47 lean down · 2 neutral", "60 thesises lean up · 46 lean down · 12 neutral", "20 thesises lean up · 36 lean down · 5 neutral", "", "", "", "", "", "", "", "", "", "", "")

f_macro_key_candidates() =>
    array.from(
      syminfo.tickerid,
      syminfo.prefix + ":" + syminfo.ticker,
      syminfo.ticker
    )

f_macro_find_index() =>
    keys = f_macro_key_candidates()
    found = -1
    for ki = 0 to array.size(keys) - 1
        key = str.upper(array.get(keys, ki))
        for i = 0 to array.size(MACRO_TV_KEYS) - 1
            if key == array.get(MACRO_TV_KEYS, i)
                found := i
                break
            if key == array.get(MACRO_SYMBOLS, i)
                found := i
                break
        if found >= 0
            break
    found

f_macro_dir_label(code) =>
    code > 0 ? "LONG" : code < 0 ? "SHORT" : "MIXED"

f_macro_dir_color(code) =>
    code > 0 ? color.new(#22c55e, 0) : code < 0 ? color.new(#ef4444, 0) : color.new(#f59e0b, 0)

var table macroPanel = table.new(position.top_right, 1, 6, bgcolor=color.new(#111110, 10), border_width=1, border_color=color.new(#888888, 40))

if barstate.islast
    idx = f_macro_find_index()
    table.cell(macroPanel, 0, 0, "Macro thesis fleet", text_color=color.white, text_size=size.small)
    if idx < 0
        table.cell(macroPanel, 0, 1, "No feed entry for this chart symbol.", text_color=color.new(#888888, 0), text_size=size.tiny)
        table.cell(macroPanel, 0, 2, str.tostring(array.size(MACRO_TV_KEYS)) + " symbols mapped in this release.", text_color=color.new(#888888, 0), text_size=size.tiny)
    else
        dirCode = array.get(MACRO_DIR, idx)
        room = array.get(MACRO_ROOM, idx)
        table.cell(macroPanel, 0, 1, array.get(MACRO_NAME, idx), text_color=color.white, text_size=size.small)
        table.cell(macroPanel, 0, 2, f_macro_dir_label(dirCode) + " · " + str.tostring(room, "#") + "% room · " + array.get(MACRO_ROOM_BAND, idx), text_color=f_macro_dir_color(dirCode), text_size=size.tiny)
        table.cell(macroPanel, 0, 3, array.get(MACRO_STRENGTH, idx), text_color=color.new(#888888, 0), text_size=size.tiny)
        leanText = array.get(MACRO_LEAN, idx)
        if str.length(leanText) > 0
            table.cell(macroPanel, 0, 4, leanText, text_color=color.new(#888888, 0), text_size=size.tiny)
            table.cell(macroPanel, 0, 5, array.get(MACRO_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
        else
            table.cell(macroPanel, 0, 4, array.get(MACRO_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
            table.cell(macroPanel, 0, 5, "", text_color=color.new(#111110, 0), text_size=size.tiny)
