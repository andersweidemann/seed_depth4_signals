var string[] MACRO_NAME = array.from("Bitcoin", "Gold Spot", "Silver Spot", "Nvidia", "Microsoft", "Meta Platforms", "Alphabet", "Amazon", "S&P 500", "Nasdaq 100", "Russell 2000", "Gold Spot", "Gold Spot", "Energy Select Sector", "Gold Miners ETF", "20+ Year Treasuries", "Euro / US Dollar", "US Dollar / Japanese Yen", "Insurance ETF", "1–3 Year Treasuries", "Royal Gold", "Ultra 7–10Y Treasury ETF", "Direxion Gold Miners Bull 2X", "Vale S.A.", "Teck Resources", "Aerospace & Defense", "Agnico Eagle Mines")
