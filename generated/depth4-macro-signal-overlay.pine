var string[] MACRO_CAUSE = array.from("If Social Security borrowing headlines persist through Q3 without benefit cuts,…", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "If fragmented shocks persist through Q3 2026, silver may re-rate as a standing hedge,…", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "GDX rises as wealthy advisors rotate taxable gains out of tech and into gold ahead…", "If the AI hardware buildout broadens through late 2026,…", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "If markup clears by October, forced Q4 rebalancing from trusts may re-rate GDX as a…", "intermediate bonds, dollar, EURUSD — Trend funds cover Treasury shorts,…", "Long bonds breathe as gold pivots to inflation hedge. Euro reprices energy-tax drag. Defense rerates.", "USDJPY stays pressured into year-end as the US-JP rate gap keeps compressing on BOJ persistence.", "KC — If the Oman backchannel stalls and escort operations stretch into late summer,…", "If reshoring metrics keep improving, investors may treat CNH as a currency to short,…", "If Trump's deregulation keeps rolling through H2 2026,…", "KIE, long-term Treasuries, intermediate bonds — If Indonesia's defense-grade procurement shift persists throu…", "copper copper, Gold, XAUUSD — Copper catches bid, gold-bond divergence tightens, stocks chop.", "HSBC may rerate from rate-beneficiary to credit-deterioration story as a stronger yen and weak China…", "Sticky long yields from fiscal pressure may keep mortgage rates too tight,…", "If real yields stay elevated, Gold loses its floor — and the dollar stays bid,…")
var string[] MACRO_NAME = array.from("Bitcoin", "Gold Spot", "Silver Spot", "S&P 500", "Nasdaq 100", "Russell 2000", "Gold Spot", "Gold Spot", "Energy Select Sector", "Gold Miners ETF", "20+ Year Treasuries", "Euro / US Dollar", "US Dollar / Japanese Yen", "Natural Gas", "Invesco CurrencyShares Japanese Yen Trust", "Insurance ETF", "Raytheon", "Aerospace & Defense", "HSBC", "SPDR S&P Homebuilders ETF", "TIPS")
var string[] MACRO_LEAN = array.from("", "93 thesises lean up · 55 lean down · 7 neutral", "", "26 thesises lean up · 21 lean down · 8 neutral", "12 thesises lean up · 12 lean down · 4 neutral", "", "93 thesises lean up · 55 lean down · 7 neutral", "93 thesises lean up · 55 lean down · 7 neutral", "", "", "68 thesises lean up · 49 lean down · 12 neutral", "", "14 thesises lean up · 14 lean down", "", "", "", "", "", "", "", "")

f_macro_key_candidates() =>
    array.from(
      syminfo.tickerid,
      syminfo.prefix + ":" + syminfo.ticker,
      syminfo.ticker
    )

f_macro_find_index() =>
    keys = f_macro_key_candidates()
    found = -1
    for ki = 0 to array.size(keys) - 1
        key = str.upper(array.get(keys, ki))
        for i = 0 to array.size(MACRO_TV_KEYS) - 1
            if key == array.get(MACRO_TV_KEYS, i)
                found := i
                break
            if key == array.get(MACRO_SYMBOLS, i)
                found := i
                break
        if found >= 0
            break
    found

f_macro_dir_label(code) =>
    code > 0 ? "LONG" : code < 0 ? "SHORT" : "MIXED"

f_macro_dir_color(code) =>
    code > 0 ? color.new(#22c55e, 0) : code < 0 ? color.new(#ef4444, 0) : color.new(#f59e0b, 0)

var table macroPanel = table.new(position.top_right, 1, 6, bgcolor=color.new(#111110, 10), border_width=1, border_color=color.new(#888888, 40))

if barstate.islast
    idx = f_macro_find_index()
    table.cell(macroPanel, 0, 0, "Macro thesis fleet", text_color=color.white, text_size=size.small)
    if idx < 0
        table.cell(macroPanel, 0, 1, "No feed entry for this chart symbol.", text_color=color.new(#888888, 0), text_size=size.tiny)
        table.cell(macroPanel, 0, 2, str.tostring(array.size(MACRO_TV_KEYS)) + " symbols mapped in this release.", text_color=color.new(#888888, 0), text_size=size.tiny)
    else
        dirCode = array.get(MACRO_DIR, idx)
        room = array.get(MACRO_ROOM, idx)
        table.cell(macroPanel, 0, 1, array.get(MACRO_NAME, idx), text_color=color.white, text_size=size.small)
        table.cell(macroPanel, 0, 2, f_macro_dir_label(dirCode) + " · " + str.tostring(room, "#") + "% room · " + array.get(MACRO_ROOM_BAND, idx), text_color=f_macro_dir_color(dirCode), text_size=size.tiny)
        table.cell(macroPanel, 0, 3, array.get(MACRO_STRENGTH, idx), text_color=color.new(#888888, 0), text_size=size.tiny)
        leanText = array.get(MACRO_LEAN, idx)
        if str.length(leanText) > 0
            table.cell(macroPanel, 0, 4, leanText, text_color=color.new(#888888, 0), text_size=size.tiny)
            table.cell(macroPanel, 0, 5, array.get(MACRO_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
        else
            table.cell(macroPanel, 0, 4, array.get(MACRO_CAUSE, idx), text_color=color.new(#ffffff, 0), text_size=size.tiny)
            table.cell(macroPanel, 0, 5, "", text_color=color.new(#111110, 0), text_size=size.tiny)
