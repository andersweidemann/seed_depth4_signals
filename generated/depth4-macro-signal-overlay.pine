var string[] MACRO_TV_KEYS = array.from("BINANCE:BTCUSDT", "OANDA:XAUUSD", "OANDA:XAGUSD", "AMEX:SPY", "NASDAQ:QQQ", "AMEX:IWM", "AMEX:GLD", "COMEX:GC1!", "AMEX:XLE", "AMEX:GDX", "NASDAQ:TLT", "OANDA:EURUSD", "OANDA:USDJPY", "AMEX:BDRY", "NYMEX:NG1!", "AMEX:EEM", "OANDA:EURJPY", "NASDAQ:FFA", "NASDAQ:BDIY", "NYSE:VALE", "NYSE:SCCO", "NYSE:TECK", "OANDA:USDNOK")
